{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "orz",
  "scopeName": "source.orz",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#chars"
    },
    {
      "include": "#function-declaration"
    },
    {
      "include": "#struct-declaration"
    },
    {
      "include": "#import"
    },
    {
      "include": "#types"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#namespaces"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.orz",
          "match": "//.*$"
        },
        {
          "name": "comment.block.orz",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "escapes": {
      "patterns": [
        {
          "name": "constant.other.placeholder.orz",
          "match": "\\{\\}"
        },
        {
          "name": "constant.character.escape.orz",
          "match": "\\{\\{|\\}\\}"
        },
        {
          "name": "constant.character.escape.orz",
          "match": "\\\\(?:lb|tab|n|t|r|\"|'|\\\\|0)"
        },
        {
          "name": "invalid.illegal.escape.orz",
          "match": "\\\\."
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.orz",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "include": "#escapes"
        }
      ]
    },
    "chars": {
      "patterns": [
        {
          "name": "string.quoted.single.orz",
          "match": "'(\\\\(?:lb|tab|n|t|r|\"|'|\\\\|0))'",
          "captures": {
            "1": {
              "name": "constant.character.escape.orz"
            }
          }
        },
        {
          "name": "string.quoted.single.orz",
          "match": "'[^'\\\\]'"
        }
      ]
    },
    "function-declaration": {
      "comment": "function 32 main(、function maybe:bignum.Big parse(、extern function …",
      "match": "\\b(function)\\s+(nothing|[A-Za-z_0-9]+(?:[:.][A-Za-z_0-9]+)*)\\s+([A-Za-z_][A-Za-z_0-9]*)",
      "captures": {
        "1": {
          "name": "storage.type.function.orz"
        },
        "2": {
          "name": "storage.type.orz"
        },
        "3": {
          "name": "entity.name.function.orz"
        }
      }
    },
    "struct-declaration": {
      "match": "\\b(struct)\\s+([A-Za-z_][A-Za-z_0-9]*)",
      "captures": {
        "1": {
          "name": "storage.type.struct.orz"
        },
        "2": {
          "name": "entity.name.type.struct.orz"
        }
      }
    },
    "import": {
      "match": "\\b(import)\\s+(?:(\"[^\"]*\")|([A-Za-z_][A-Za-z_0-9]*))(?:\\s+(as)\\s+([A-Za-z_][A-Za-z_0-9]*))?",
      "captures": {
        "1": {
          "name": "keyword.control.import.orz"
        },
        "2": {
          "name": "string.quoted.double.orz"
        },
        "3": {
          "name": "entity.name.namespace.orz"
        },
        "4": {
          "name": "keyword.control.import.orz"
        },
        "5": {
          "name": "entity.name.namespace.orz"
        }
      }
    },
    "types": {
      "comment": "`:` の後は型（x:32、array:maybe:Node、geom.Point、to:32(x)、push:32(…)）",
      "patterns": [
        {
          "match": "(:)\\s*(8|32|64|bool|decnum|string|pointer|array|address|maybe|nothing|function)\\b",
          "captures": {
            "1": {
              "name": "punctuation.separator.type.orz"
            },
            "2": {
              "name": "storage.type.orz"
            }
          }
        },
        {
          "match": "(:)\\s*([A-Za-z_][A-Za-z_0-9]*)(\\.)([A-Za-z_][A-Za-z_0-9]*)",
          "captures": {
            "1": {
              "name": "punctuation.separator.type.orz"
            },
            "2": {
              "name": "entity.name.namespace.orz"
            },
            "3": {
              "name": "punctuation.accessor.orz"
            },
            "4": {
              "name": "entity.name.type.orz"
            }
          }
        },
        {
          "match": "(:)\\s*([A-Za-z_][A-Za-z_0-9]*)",
          "captures": {
            "1": {
              "name": "punctuation.separator.type.orz"
            },
            "2": {
              "name": "entity.name.type.orz"
            }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.orz",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.decimal.orz",
          "match": "\\b[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.orz",
          "match": "\\b(?:if|else|while|break|continue|return|arena)\\b"
        },
        {
          "name": "storage.type.function.orz",
          "match": "\\bfunction\\b"
        },
        {
          "name": "storage.type.struct.orz",
          "match": "\\bstruct\\b"
        },
        {
          "name": "storage.modifier.orz",
          "match": "\\b(?:export|immutable|extern)\\b"
        },
        {
          "name": "keyword.control.import.orz",
          "match": "\\b(?:import|as)\\b"
        },
        {
          "name": "keyword.operator.logical.orz",
          "match": "\\b(?:and|nand|or|xor|nor|xnor|not)\\b"
        },
        {
          "name": "constant.language.orz",
          "match": "\\b(?:true|false|null)\\b"
        },
        {
          "name": "keyword.other.conversion.orz",
          "match": "\\bto\\b"
        },
        {
          "name": "storage.type.orz",
          "match": "\\b(?:bool|decnum|string|pointer|array|address|maybe|nothing)\\b"
        }
      ]
    },
    "builtins": {
      "name": "support.function.builtin.orz",
      "match": "\\b(?:allocate|length|size|bytes|copy|collect)\\b(?=\\s*\\()"
    },
    "namespaces": {
      "comment": "stdio.print(…) や geom.Point(…) の、点の前の名前",
      "patterns": [
        {
          "match": "\\b(stdio|sys|strings|lists|maps|os|bignum|math|random|crypto|socket)\\s*(?=\\.)",
          "captures": {
            "1": {
              "name": "entity.name.namespace.orz"
            }
          }
        },
        {
          "match": "\\b([a-z_][A-Za-z_0-9]*)\\s*(?=\\.\\s*[A-Za-z_][A-Za-z_0-9]*\\s*(?::[A-Za-z_0-9.]+)*\\s*\\()",
          "captures": {
            "1": {
              "name": "entity.name.namespace.orz"
            }
          }
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "comment": "構造体を作る（Point(1, 2)、List:32(…)）",
          "match": "\\b([A-Z][A-Za-z_0-9]*)(?=\\s*(?::(?!function\\b)[A-Za-z_0-9.]+)*\\s*\\()",
          "captures": {
            "1": {
              "name": "entity.name.type.orz"
            }
          }
        },
        {
          "match": "\\b([a-z_][A-Za-z_0-9]*)(?=\\s*(?::(?!function\\b)[A-Za-z_0-9.]+)*\\s*\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.orz"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.bitwise.shift.orz",
          "match": "<<|>>"
        },
        {
          "name": "keyword.operator.comparison.orz",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.orz",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.orz",
          "match": "[-+*/%^]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.orz",
          "match": ";"
        },
        {
          "name": "punctuation.separator.comma.orz",
          "match": ","
        },
        {
          "name": "punctuation.accessor.orz",
          "match": "\\."
        }
      ]
    }
  }
}
