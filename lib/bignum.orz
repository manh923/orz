// bignum：大きな整数（標準ライブラリ）
//
// import bignum; で使う。値は bignum.Big 型。作った値は変わらない（計算のたびに新しい値を作る）。
//
//     a:bignum.Big = bignum.from(12345);
//     b:maybe:bignum.Big = bignum.parse("123456789012345678901234567890");
//     if (b != null) {
//         bignum.print(bignum.mul(a, b));
//     }
//
// 割り算は整数の / と % と同じ（0 の方向に切り捨て、余りの符号は割られる数と同じ）。
// 0 で割ったときや、pow の指数が負のときは、整数と同じく実行時エラーで止まる。
//
// 中身は 10 億（10^9）進数。limbs[0] がいちばん下の桁で、いちばん上の桁は 0 でない（0 は空の配列）。

import stdio;

export struct Big {
    negative:bool;
    limbs:array:64;
}

immutable BASE:64 = 1000000000;

// ---------------- 作る・変換する ----------------

export function Big from(x:64) {
    a:array:64 = array(3);
    n:32 = 0;
    v:64 = x;
    while (v != 0) {
        r:64 = v % BASE;
        if (r < 0) {
            r = -r;
        }
        a[n] = r;
        n = n + 1;
        v = v / BASE;
    }
    return make(x < 0, a, n);
}

// 10 進の数字（先頭に + か - があってもよい）。読めなければ null。
export function maybe:Big parse(s:string) {
    p:pointer:8 = bytes(s);
    n:32 = length(s);
    start:32 = 0;
    negative:bool = false;
    if (n > 0 and (p[0] == 43 or p[0] == 45)) {
        negative = p[0] == 45;
        start = 1;
    }
    if (start == n) {
        return null;
    }
    i:32 = start;
    while (i < n) {
        if (p[i] < 48 or p[i] > 57) {
            return null;
        }
        i = i + 1;
    }
    limbs:array:64 = array((n - start) / 9 + 1);
    k:32 = 0;
    end:32 = n;
    while (end > start) {
        first:32 = end - 9;
        if (first < start) {
            first = start;
        }
        v:64 = 0;
        j:32 = first;
        while (j < end) {
            v = v * 10 + to:64(p[j]) - 48;
            j = j + 1;
        }
        limbs[k] = v;
        k = k + 1;
        end = first;
    }
    return make(negative, limbs, k);
}

export function string to_string(a:Big) {
    n:32 = length(a.limbs);
    if (n == 0) {
        return "0";
    }
    head:string = to:string(a.limbs[n - 1]);
    total:32 = length(head) + (n - 1) * 9;
    if (a.negative) {
        total = total + 1;
    }
    s:string = zeros(total);
    p:pointer:8 = bytes(s);
    k:32 = 0;
    if (a.negative) {
        p[0] = 45;
        k = 1;
    }
    hp:pointer:8 = bytes(head);
    i:32 = 0;
    while (i < length(head)) {
        p[k] = hp[i];
        k = k + 1;
        i = i + 1;
    }
    // 下の桁は、9 桁に 0 を詰める。
    j:32 = n - 2;
    while (j >= 0) {
        x:64 = a.limbs[j];
        d:32 = 8;
        while (d >= 0) {
            p[k + d] = to:8(48 + x % 10);
            x = x / 10;
            d = d - 1;
        }
        k = k + 9;
        j = j - 1;
    }
    return s;
}

export function nothing print(a:Big) {
    stdio.print(to_string(a));
}

// 64 に入らなければ null。
export function maybe:64 to_64(a:Big) {
    if (compare(a, from(9223372036854775807)) > 0 or compare(a, from(-9223372036854775807 - 1)) < 0) {
        return null;
    }
    // 負の方で足していく（-9223372036854775808 も入るように）。
    acc:64 = 0;
    i:32 = length(a.limbs) - 1;
    while (i >= 0) {
        acc = acc * BASE - a.limbs[i];
        i = i - 1;
    }
    if (a.negative) {
        return acc;
    }
    return -acc;
}

// ---------------- 比べる ----------------

// a < b なら -1、同じなら 0、a > b なら 1。
export function 32 compare(a:Big, b:Big) {
    if (a.negative != b.negative) {
        if (a.negative) {
            return -1;
        }
        return 1;
    }
    c:32 = compare_abs(a.limbs, b.limbs);
    if (a.negative) {
        return -c;
    }
    return c;
}

export function bool is_zero(a:Big) {
    return length(a.limbs) == 0;
}

// ---------------- 計算 ----------------

export function Big neg(a:Big) {
    return Big((not a.negative) and length(a.limbs) > 0, a.limbs);
}

export function Big abs(a:Big) {
    return Big(false, a.limbs);
}

export function Big add(a:Big, b:Big) {
    return add_signed(a, b.limbs, b.negative);
}

export function Big sub(a:Big, b:Big) {
    return add_signed(a, b.limbs, not b.negative);
}

export function Big mul(a:Big, b:Big) {
    r:array:64 = mul_abs(a.limbs, b.limbs);
    return make(a.negative != b.negative, r, length(r));
}

// 0 の方向に切り捨てる。
export function Big div(a:Big, b:Big) {
    check_divisor(b);
    dm:DivMod = divmod_abs(a.limbs, b.limbs);
    return make(a.negative != b.negative, dm.q, length(dm.q));
}

// 符号は a と同じ。
export function Big mod(a:Big, b:Big) {
    check_divisor(b);
    dm:DivMod = divmod_abs(a.limbs, b.limbs);
    return make(a.negative, dm.r, length(dm.r));
}

// a の n 乗。
export function Big pow(a:Big, n:32) {
    // 指数が負なら、整数の ^ と同じく実行時エラーで止まる。
    one:32 = 1;
    check:32 = one ^ n;
    result:Big = from(1);
    base:Big = a;
    e:32 = n;
    while (e > 0) {
        if (e % 2 == 1) {
            result = mul(result, base);
        }
        e = e / 2;
        if (e > 0) {
            base = mul(base, base);
        }
    }
    return result;
}

// ---------------- 中で使うもの ----------------

// a の下から n 桁を使って作る。上の 0 の桁は除く。
function Big make(negative:bool, a:array:64, n:32) {
    k:32 = n;
    while (k > 0 and a[k - 1] == 0) {
        k = k - 1;
    }
    limbs:array:64 = array(k);
    i:32 = 0;
    while (i < k) {
        limbs[i] = a[i];
        i = i + 1;
    }
    return Big(negative and k > 0, limbs);
}

// 長さ n の、0 を並べた文字列（あとから bytes で書き換える）。
function string zeros(n:32) {
    s:string = "";
    piece:string = "0";
    k:32 = n;
    while (k > 0) {
        if (k % 2 == 1) {
            s = s + piece;
        }
        k = k / 2;
        if (k > 0) {
            piece = piece + piece;
        }
    }
    return s;
}

// 0 で割ったら、整数の / と同じく実行時エラーで止まる。
function nothing check_divisor(b:Big) {
    one:32 = 1;
    check:32 = one / length(b.limbs);
}

// |a| と |b| を比べる。
function 32 compare_abs(a:array:64, b:array:64) {
    if (length(a) != length(b)) {
        if (length(a) < length(b)) {
            return -1;
        }
        return 1;
    }
    i:32 = length(a) - 1;
    while (i >= 0) {
        if (a[i] != b[i]) {
            if (a[i] < b[i]) {
                return -1;
            }
            return 1;
        }
        i = i - 1;
    }
    return 0;
}

// a + b。b の符号は b_negative（sub では反対にして呼ぶ）。
function Big add_signed(a:Big, b:array:64, b_negative:bool) {
    if (a.negative == b_negative) {
        sum:array:64 = add_abs(a.limbs, b);
        return make(a.negative, sum, length(sum));
    }
    c:32 = compare_abs(a.limbs, b);
    if (c == 0) {
        return make(false, b, 0);
    }
    if (c > 0) {
        d1:array:64 = sub_abs(a.limbs, b);
        return make(a.negative, d1, length(d1));
    }
    d2:array:64 = sub_abs(b, a.limbs);
    return make(b_negative, d2, length(d2));
}

// |a| + |b|
function array:64 add_abs(a:array:64, b:array:64) {
    n:32 = length(a);
    if (length(b) > n) {
        n = length(b);
    }
    r:array:64 = array(n + 1);
    carry:64 = 0;
    i:32 = 0;
    while (i < n) {
        s:64 = carry;
        if (i < length(a)) {
            s = s + a[i];
        }
        if (i < length(b)) {
            s = s + b[i];
        }
        r[i] = s % BASE;
        carry = s / BASE;
        i = i + 1;
    }
    r[n] = carry;
    return r;
}

// |a| - |b|（|a| >= |b| のとき）
function array:64 sub_abs(a:array:64, b:array:64) {
    r:array:64 = array(length(a));
    borrow:64 = 0;
    i:32 = 0;
    while (i < length(a)) {
        s:64 = a[i] - borrow;
        if (i < length(b)) {
            s = s - b[i];
        }
        if (s < 0) {
            s = s + BASE;
            borrow = 1;
        } else {
            borrow = 0;
        }
        r[i] = s;
        i = i + 1;
    }
    return r;
}

// |a| * |b|
function array:64 mul_abs(a:array:64, b:array:64) {
    r:array:64 = array(length(a) + length(b));
    i:32 = 0;
    while (i < length(a)) {
        carry:64 = 0;
        ai:64 = a[i];
        j:32 = 0;
        while (j < length(b)) {
            t:64 = r[i + j] + ai * b[j] + carry;
            r[i + j] = t % BASE;
            carry = t / BASE;
            j = j + 1;
        }
        r[i + length(b)] = carry;
        i = i + 1;
    }
    return r;
}

// |a| に小さい数 f（BASE より小さい）を掛けて、長さ len にする。
function array:64 mul_small(a:array:64, f:64, len:32) {
    r:array:64 = array(len);
    carry:64 = 0;
    i:32 = 0;
    while (i < length(a)) {
        t:64 = a[i] * f + carry;
        r[i] = t % BASE;
        carry = t / BASE;
        i = i + 1;
    }
    if (i < len) {
        r[i] = carry;
    }
    return r;
}

struct DivMod {
    q:array:64;
    r:array:64;
}

// |a| ÷ |b| の商と余り（b は 0 でない）。Knuth のアルゴリズム D。
function DivMod divmod_abs(a:array:64, b:array:64) {
    if (compare_abs(a, b) < 0) {
        return DivMod(array(0), a);
    }
    n:32 = length(b);
    if (n == 1) {
        d:64 = b[0];
        q1:array:64 = array(length(a));
        rem:64 = 0;
        i:32 = length(a) - 1;
        while (i >= 0) {
            cur:64 = rem * BASE + a[i];
            q1[i] = cur / d;
            rem = cur % d;
            i = i - 1;
        }
        return DivMod(q1, [rem]);
    }
    // 割る数のいちばん上の桁が BASE / 2 以上になるように、両方に f を掛けておく。
    m:32 = length(a) - n;
    f:64 = BASE / (b[n - 1] + 1);
    u:array:64 = mul_small(a, f, length(a) + 1);
    v:array:64 = mul_small(b, f, n);
    q:array:64 = array(m + 1);
    j:32 = m;
    while (j >= 0) {
        // 商の 1 桁を、上の 2 桁から見積もる（大きすぎても 2 までなので、ここで直す）。
        num:64 = u[j + n] * BASE + u[j + n - 1];
        qhat:64 = num / v[n - 1];
        rhat:64 = num % v[n - 1];
        while (qhat >= BASE or qhat * v[n - 2] > rhat * BASE + u[j + n - 2]) {
            qhat = qhat - 1;
            rhat = rhat + v[n - 1];
            if (rhat >= BASE) {
                break;
            }
        }
        // u[j..j+n] から qhat * v を引く。
        borrow:64 = 0;
        carry:64 = 0;
        k:32 = 0;
        while (k < n) {
            p:64 = qhat * v[k] + carry;
            carry = p / BASE;
            s:64 = u[k + j] - p % BASE - borrow;
            if (s < 0) {
                u[k + j] = s + BASE;
                borrow = 1;
            } else {
                u[k + j] = s;
                borrow = 0;
            }
            k = k + 1;
        }
        top:64 = u[j + n] - carry - borrow;
        if (top < 0) {
            // 引きすぎた（まれ）。1 つ減らして、v を足し戻す。
            qhat = qhat - 1;
            c:64 = 0;
            k2:32 = 0;
            while (k2 < n) {
                s2:64 = u[k2 + j] + v[k2] + c;
                u[k2 + j] = s2 % BASE;
                c = s2 / BASE;
                k2 = k2 + 1;
            }
            top = top + c;
        }
        u[j + n] = top;
        q[j] = qhat;
        j = j - 1;
    }
    // 余りは、u の下 n 桁を f で割ったもの。
    r:array:64 = array(n);
    rem2:64 = 0;
    i2:32 = n - 1;
    while (i2 >= 0) {
        cur2:64 = rem2 * BASE + u[i2];
        r[i2] = cur2 / f;
        rem2 = cur2 % f;
        i2 = i2 - 1;
    }
    return DivMod(q, r);
}
