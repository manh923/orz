// strings：文字列を扱う（標準ライブラリ）
//
// import strings; で使う。位置と長さはバイト単位（UTF-8 の 1 文字は 1〜4 バイト）。
//
//     strings.slice("hello", 1, 3)        // "el"（1 バイト目から 3 バイト目の手前まで）
//     strings.find("hello", "l", 0)       // 2（0 バイト目から探す。なければ -1）
//     strings.split("a,b,c", ",")         // ["a", "b", "c"]
//     strings.join(["a", "b"], "-")       // "a-b"
//
// 長い文字列を少しずつ作るときは Builder を使う（+ でつなぐと、そのたびに全体を写すので遅い）。
//
//     b:strings.Builder = strings.builder();
//     strings.add(b, "abc");
//     strings.add_byte(b, 10);
//     s:string = strings.text(b);

extern function string orz_rt_str_from_bytes(p:pointer:8, n:64);
extern function nothing orz_rt_fail(msg:string);

// s の start バイト目から、end バイト目の手前まで。範囲が文字列の外なら実行時エラー。
export function string slice(s:string, start:32, end:32) {
    if (start < 0 or end > length(s) or start > end) {
        range:string = "（" + to:string(start) + "〜" + to:string(end) + "）";
        orz_rt_fail("strings.slice の範囲" + range + "が、長さ " + to:string(length(s)) + " の文字列の外です");
    }
    return orz_rt_str_from_bytes(byte_at(s, start), to:64(end - start));
}

// s の start バイト目から sub を探して、見つかった位置を返す。なければ -1。
export function 32 find(s:string, sub:string, start:32) {
    p:pointer:8 = bytes(s);
    q:pointer:8 = bytes(sub);
    i:32 = start;
    if (i < 0) {
        i = 0;
    }
    while (i + length(sub) <= length(s)) {
        j:32 = 0;
        while (j < length(sub) and p[i + j] == q[j]) {
            j = j + 1;
        }
        if (j == length(sub)) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

export function bool contains(s:string, sub:string) {
    return find(s, sub, 0) >= 0;
}

export function bool starts_with(s:string, prefix:string) {
    return length(prefix) <= length(s) and same_at(s, 0, prefix);
}

export function bool ends_with(s:string, suffix:string) {
    return length(suffix) <= length(s) and same_at(s, length(s) - length(suffix), suffix);
}

// sep で区切る。sep が空なら実行時エラー。
export function array:string split(s:string, sep:string) {
    if (length(sep) == 0) {
        orz_rt_fail("strings.split の区切りが空です");
    }
    // 先に数えてから作る。
    n:32 = 1;
    i:32 = find(s, sep, 0);
    while (i >= 0) {
        n = n + 1;
        i = find(s, sep, i + length(sep));
    }
    parts:array:string = array(n);
    k:32 = 0;
    start:32 = 0;
    i = find(s, sep, 0);
    while (i >= 0) {
        parts[k] = slice(s, start, i);
        k = k + 1;
        start = i + length(sep);
        i = find(s, sep, start);
    }
    parts[k] = slice(s, start, length(s));
    return parts;
}

// parts を sep でつなぐ。
export function string join(parts:array:string, sep:string) {
    b:Builder = builder();
    i:32 = 0;
    while (i < length(parts)) {
        if (i > 0) {
            add(b, sep);
        }
        add(b, parts[i]);
        i = i + 1;
    }
    return text(b);
}

// 前後の空白（スペース、タブ、改行）を除く。
export function string trim(s:string) {
    p:pointer:8 = bytes(s);
    start:32 = 0;
    end:32 = length(s);
    while (start < end and is_space(p[start])) {
        start = start + 1;
    }
    while (end > start and is_space(p[end - 1])) {
        end = end - 1;
    }
    return slice(s, start, end);
}

// old をすべて new に置き換える。old が空なら実行時エラー。
export function string replace(s:string, old:string, new:string) {
    if (length(old) == 0) {
        orz_rt_fail("strings.replace の置き換える文字列が空です");
    }
    b:Builder = builder();
    start:32 = 0;
    i:32 = find(s, old, 0);
    while (i >= 0) {
        add(b, slice(s, start, i));
        add(b, new);
        start = i + length(old);
        i = find(s, old, start);
    }
    add(b, slice(s, start, length(s)));
    return text(b);
}

// s を n 回つなぐ。
export function string repeat(s:string, n:32) {
    b:Builder = builder();
    i:32 = 0;
    while (i < n) {
        add(b, s);
        i = i + 1;
    }
    return text(b);
}

// 1 バイトの文字列。
export function string from_byte(c:8) {
    a:array:8 = [c];
    return orz_rt_str_from_bytes(bytes(to:address(a)), 1);
}

// 英字を小文字にする（A〜Z だけ。ほかの文字はそのまま）。
export function string lower(s:string) {
    p:pointer:8 = bytes(s);
    b:Builder = builder();
    i:32 = 0;
    while (i < length(s)) {
        c:8 = p[i];
        if (c >= 65 and c <= 90) {
            c = c + 32;
        }
        add_byte(b, c);
        i = i + 1;
    }
    return text(b);
}

// 英字を大文字にする（a〜z だけ。ほかの文字はそのまま）。
export function string upper(s:string) {
    p:pointer:8 = bytes(s);
    b:Builder = builder();
    i:32 = 0;
    while (i < length(s)) {
        c:8 = p[i];
        if (c >= 97 and c <= 122) {
            c = c - 32;
        }
        add_byte(b, c);
        i = i + 1;
    }
    return text(b);
}

// バイトの順で比べる。a が前なら -1、同じなら 0、後なら 1。
export function 32 compare(a:string, b:string) {
    p:pointer:8 = bytes(a);
    q:pointer:8 = bytes(b);
    i:32 = 0;
    while (i < length(a) and i < length(b)) {
        if (p[i] != q[i]) {
            if (p[i] < q[i]) {
                return -1;
            }
            return 1;
        }
        i = i + 1;
    }
    if (length(a) < length(b)) {
        return -1;
    }
    if (length(a) > length(b)) {
        return 1;
    }
    return 0;
}

// ---------------- Builder ----------------

export struct Builder {
    data:array:8;
    count:32;
}

export function Builder builder() {
    return Builder(array(64), 0);
}

export function nothing add(b:Builder, s:string) {
    reserve(b, length(s));
    p:pointer:8 = bytes(s);
    i:32 = 0;
    while (i < length(s)) {
        b.data[b.count + i] = p[i];
        i = i + 1;
    }
    b.count = b.count + length(s);
}

export function nothing add_byte(b:Builder, c:8) {
    reserve(b, 1);
    b.data[b.count] = c;
    b.count = b.count + 1;
}

// 今までに足した長さ（バイト）。
export function 32 count(b:Builder) {
    return b.count;
}

// 今までに足したものを、文字列にする（Builder はそのまま使い続けられる）。
export function string text(b:Builder) {
    return orz_rt_str_from_bytes(bytes(to:address(b.data)), to:64(b.count));
}

// ---------------- 中で使うもの ----------------

// s の i バイト目を指すポインタ。
function pointer:8 byte_at(s:string, i:32) {
    return bytes(to:address(bytes(s)) + to:address(to:64(i)));
}

// s の i バイト目から、sub と同じか。
function bool same_at(s:string, i:32, sub:string) {
    p:pointer:8 = bytes(s);
    q:pointer:8 = bytes(sub);
    j:32 = 0;
    while (j < length(sub)) {
        if (p[i + j] != q[j]) {
            return false;
        }
        j = j + 1;
    }
    return true;
}

function bool is_space(c:8) {
    return c == 32 or c == 9 or c == 10 or c == 13;
}

// あと n バイト入るように広げる。
function nothing reserve(b:Builder, n:32) {
    if (b.count + n <= length(b.data)) {
        return;
    }
    cap:32 = length(b.data) * 2;
    while (cap < b.count + n) {
        cap = cap * 2;
    }
    bigger:array:8 = array(cap);
    i:32 = 0;
    while (i < b.count) {
        bigger[i] = b.data[i];
        i = i + 1;
    }
    b.data = bigger;
}
