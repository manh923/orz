// exit: 0
// arena の中でハッシュ表を作って使う。外のもの（中に別のものを持つ）を arena の中のものに入れても、読むだけなら使える
import stdio;

struct Entry {
    key:string;
    value:32;
    next:maybe:Entry;
}

struct Map {
    buckets:array:maybe:Entry;
    size:32;
}

struct Box {
    items:array:string;
}

struct Holder {
    b:Box;
    name:string;
}

function Map new_map(n:32) {
    return Map(array(n), 0);
}

function 32 hash(s:string) {
    h:32 = 0;
    b:pointer:8 = bytes(s);
    i:32 = 0;
    while (i < length(s)) {
        h = (h * 31 + to:32(b[i])) % 100003;
        i = i + 1;
    }
    return h;
}

function nothing put(m:Map, k:string, v:32) {
    i:32 = hash(k) % length(m.buckets);
    e:maybe:Entry = m.buckets[i];
    while (e != null) {
        if (e.key == k) {
            e.value = v;
            return;
        }
        e = e.next;
    }
    m.buckets[i] = Entry(k, v, m.buckets[i]);
    m.size = m.size + 1;
}

function maybe:32 get(m:Map, k:string) {
    e:maybe:Entry = m.buckets[hash(k) % length(m.buckets)];
    while (e != null) {
        if (e.key == k) {
            return e.value;
        }
        e = e.next;
    }
    return null;
}

function Box wrap(s:string) {
    return Box([s, s + s]);
}

function string pick(h:Holder) {
    return h.b.items[0];
}

function nothing set_name(h:Holder, s:string) {
    h.name = s;
}

function 32 apply(f:function:32(string), s:string) {
    return f(s);
}

function 32 len2(s:string) {
    return length(s) * 2;
}

global_map:Map = Map(array(16), 0);

function nothing main() {
    put(global_map, "外", 1);
    outer_box:Box = Box(["o1", "o2"]);
    hits:32 = 0;
    i:32 = 0;
    while (i < 300) {
        arena {
            m:Map = new_map(8);
            j:32 = 0;
            while (j < 50) {
                put(m, "k" + to:string(j % 20), j);
                j = j + 1;
            }
            v:maybe:32 = get(m, "k7");
            if (v != null) {
                hits = hits + v;
            }
            g:maybe:32 = get(global_map, "外");
            if (g != null) {
                hits = hits + g;
            }
            // 外のもの（中に別のものを持つ）を、arena の中のものに入れて、読むだけなら使える
            h:Holder = Holder(outer_box, "名前");
            set_name(h, "新しい" + to:string(i));
            hits = hits + length(pick(h));
            others:array:Box = [outer_box, wrap(to:string(i))];
            hits = hits + length(others[1].items[1]);
            c:Holder = copy(h);
            c.name = c.name + "!";
            hits = hits + apply(len2, c.name);
            outer_box.items[0] = "o1";
        }
        i = i + 1;
    }
    stdio.print(hits);
    stdio.print(m_size());
}

function 32 m_size() {
    return global_map.size;
}
