// exit: 0
// 標準ライブラリ bignum（大きな整数）
import stdio;
import bignum;

function nothing show(s:string) {
    m:maybe:bignum.Big = bignum.parse(s);
    if (m == null) {
        stdio.print("null");
    } else {
        bignum.print(m);
    }
}

function nothing main() {
    a:bignum.Big = bignum.from(123456789);
    b:maybe:bignum.Big = bignum.parse("-98765432109876543210987654321");
    if (b != null) {
        bignum.print(bignum.add(a, b));
        bignum.print(bignum.sub(a, b));
        bignum.print(bignum.mul(a, b));
        bignum.print(bignum.div(b, a));
        bignum.print(bignum.mod(b, a));
        bignum.print(bignum.pow(bignum.from(2), 200));
        stdio.print(bignum.compare(a, b));
        stdio.print(bignum.to_64(a));
        stdio.print(bignum.to_64(b));
    }
    f:bignum.Big = bignum.from(1);
    i:64 = 1;
    while (i <= 50) {
        f = bignum.mul(f, bignum.from(i));
        i = i + 1;
    }
    bignum.print(f);
    bignum.print(bignum.from(-9223372036854775807 - 1));
    // 読めない文字列は null
    show("");
    show("-");
    show("+");
    show("12a");
    show(" 12");
    show("--1");
    show("+0");
    show("-0");
    show("000123");
    show("-000000000000000000000000000001");
    show("1000000000000000000000000000000");
    g:bignum.Big = bignum.from(1);
    k:64 = 1;
    while (k <= 1000) {
        g = bignum.mul(g, bignum.from(k));
        k = k + 1;
    }
    s:string = bignum.to_string(g);
    stdio.print(length(s));
    p:bignum.Big = bignum.pow(bignum.from(3), 20000);
    stdio.print(length(bignum.to_string(p)));
    q:bignum.Big = bignum.div(p, g);
    stdio.print(length(bignum.to_string(q)));
    bignum.print(bignum.mod(p, bignum.from(1000000007)));
}
