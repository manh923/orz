// exit: 0
// 列挙型で作った木を、GC が正しく残し、捨てたものを回収する。
import stdio;

enum Tree {
    Leaf;
    Node(left:Tree, value:32, right:Tree);
}

function Tree insert(t:Tree, v:32) {
    match (t) {
        Leaf {
            return Tree.Node(Tree.Leaf, v, Tree.Leaf);
        }
        Node {
            if (v < t.value) {
                return Tree.Node(insert(t.left, v), t.value, t.right);
            }
            return Tree.Node(t.left, t.value, insert(t.right, v));
        }
    }
}

function 64 total(t:Tree) {
    match (t) {
        Leaf {
            return 0;
        }
        Node {
            return total(t.left) + to:64(t.value) + total(t.right);
        }
    }
}

function 32 count(t:Tree) {
    match (t) {
        Leaf {
            return 0;
        }
        Node {
            return count(t.left) + 1 + count(t.right);
        }
    }
}

function nothing main() {
    t:Tree = Tree.Leaf;
    seed:64 = 12345;
    i:32 = 0;
    while (i < 20000) {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        t = insert(t, to:32(seed % 1000000));
        if (i % 5000 == 0) {
            collect();
        }
        i = i + 1;
    }
    collect();
    stdio.print(total(t));
    stdio.print(count(t));
    // 捨てた木は回収される。
    round:32 = 0;
    while (round < 30) {
        u:Tree = Tree.Leaf;
        j:32 = 0;
        while (j < 3000) {
            seed = (seed * 1103515245 + 12345) % 2147483648;
            u = insert(u, to:32(seed % 1000));
            j = j + 1;
        }
        round = round + 1;
    }
    collect();
    stdio.print(total(t));
    stdio.print(count(t));
}
