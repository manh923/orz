// error: 列挙型 `Expr` の中身は、`match` で種類を確かめてから使います
import stdio;

enum Expr {
    Num(value:64);
    Add(left:Expr, right:Expr);
    Neg(inner:Expr);
}

function 64 f(e:Expr, other:Expr, swap:bool) {
    match (e) {
        Num {
            if (swap) {
                e = other;
            }
            return e.value;
        }
        else {
            return 0;
        }
    }
}

function nothing main() {
    stdio.print(f(Expr.Num(1), Expr.Neg(Expr.Num(2)), true));
}
