// error: 列挙型 `Expr` の中身は、`match` で種類を確かめてから使います
import stdio;

enum Expr {
    Num(value:64);
    Add(left:Expr, right:Expr);
    Neg(inner:Expr);
}

// 確かめられるのはローカル変数と引数だけ。配列の要素は、変数に入れてから調べる。
function 64 f(list:array:Expr) {
    match (list[0]) {
        Num {
            return list[0].value;
        }
        else {
            return 0;
        }
    }
}

function nothing main() {
    stdio.print(f([Expr.Num(1)]));
}
