// exit: 31
// 別々のブロックなら同じ名前を使える。while の中の宣言は毎回やり直す
function 32 main() {
    r:32 = 0;
    if (r == 0) {
        x:32 = 1;
        r = r + x;
    } else {
        x:32 = 2;
        r = r + x;
    }
    i:32 = 0;
    while (i < 3) {
        y:32 = i * 10;
        r = r + y;
        i = i + 1;
    }
    return r;
}
