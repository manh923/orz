// exit: 0
// 標準ライブラリ strings
import stdio;
import strings;

function nothing main() {
    stdio.print(strings.slice("hello", 1, 3));
    stdio.print(strings.slice("日本語", 3, 6));
    stdio.print(strings.find("hello", "l", 0));
    stdio.print(strings.find("hello", "l", 3));
    stdio.print(strings.find("hello", "z", 0));
    stdio.print(strings.contains("hello", "ell"));
    stdio.print(strings.split("a,b,,c", ","));
    stdio.print(strings.split("", ","));
    stdio.print(strings.join(["x", "y", "z"], "-"));
    stdio.print(strings.trim("  \t hi there \n"));
    stdio.print(strings.replace("a-b-c", "-", "+"));
    stdio.print(strings.repeat("ab", 3));
    stdio.print(strings.from_byte(65));
    stdio.print(strings.compare("abc", "abd"));
    stdio.print(strings.compare("b", "abc"));
    stdio.print(strings.compare("ab", "ab"));
    stdio.print(strings.starts_with("日本語", "日本"));
    stdio.print(strings.ends_with("file.orz", ".orh"));
    // 長い文字列は Builder で作る
    b:strings.Builder = strings.builder();
    i:32 = 0;
    while (i < 1000) {
        strings.add(b, to:string(i));
        strings.add_byte(b, 32);
        i = i + 1;
    }
    s:string = strings.text(b);
    stdio.print(length(s));
    stdio.print(strings.count(b));
    stdio.print(strings.slice(s, length(s) - 8, length(s)));
}
